{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-dashboard",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-01-01",
  // Static frontend. Only API paths invoke the Worker; everything else is
  // served straight from Cloudflare's asset cache at no Worker cost.
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "observability": { "enabled": true },
  // Rolling news store written by the cron run (namespace "world-dashboard-news-cache").
  "kv_namespaces": [{ "binding": "NEWS_KV", "id": "458324aeb19d4ca38ab1537a4301cbad" }],
  // Pull newly published GDELT feed files into KV; visitors only read KV.
  // Each run writes KV once or twice — well inside the free plan's 1000/day.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // How much news the store keeps.
    "FEED_WINDOW": "1d",
    // How long an isolate reuses what it read from KV, and how long a stale
    // copy may still be served while re-reading in the background.
    "CACHE_TTL_SECONDS": "60",
    "CACHE_STALE_SECONDS": "86400",
    "CORS_ALLOW_ORIGINS": "*"
  }
}
